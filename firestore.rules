rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == "le.dupont.pro@gmail.com";
    }

    function isOwner(resourceData) {
      return isAuthenticated() && (
        resourceData.ownerEmail == request.auth.token.email ||
        resourceData.userId == request.auth.uid
      );
    }

    // Collection des services surveillés (cloisonnée par compte)
    match /services/{serviceId} {
      // Lecture strictement réservée à l'administrateur ou au propriétaire
      allow read: if isAdmin() || isOwner(resource.data);

      // Création : l'utilisateur authentifié devient le propriétaire (ou l'administrateur)
      allow create: if isAdmin() || (
        isAuthenticated() && (
          request.resource.data.ownerEmail == request.auth.token.email ||
          request.resource.data.userId == request.auth.uid
        )
      );

      // Modification : Administrateur OU propriétaire du service
      // (Permet également les mises à jour des pings et métriques automatisées)
      allow update: if isAdmin() || isOwner(resource.data) || (
        // Permet l'enregistrement des pings périodiques
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['statusCode', 'status', 'responseTime', 'lastCheck', 'history', 'uptimePercentage', 'lastError'])
      );

      // Suppression : Administrateur OU propriétaire uniquement
      allow delete: if isAdmin() || isOwner(resource.data);

      // Sous-collection des pings
      match /pings/{pingId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // Logs d'activité
    match /logs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // Profils utilisateurs
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
