rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Les services et pings sont lisibles publiquement pour la Status Page
    match /services/{serviceId} {
      allow read: if true;
      allow write: if request.auth != null || request.headers['x-admin-key'] != null;

      // Historique des pings pour un service
      match /pings/{pingId} {
        allow read: if true;
        allow write: if request.auth != null || request.headers['x-admin-key'] != null;
      }
    }

    match /ping_history/{pingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /incidents/{incidentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
